# Absolute path to your Obsidian vault (the folder containing .obsidian).
# The container mounts this at /vault, so the destination inside the app is /vault/raw.
OBSIDIAN_VAULT=/Users/you/Documents/MyVault

# Optional, and host-only — Docker has no Chrome to borrow.
# Reuse a Chrome profile so pages behind a login capture as the logged-in you.
# Point this at a COPY: Chrome must be quit, and every cookie in the profile is
# sent to whatever the crawl reaches. See "Pages behind a login" in the README.
# OAC_CHROME_PROFILE=/tmp/oac-profile
